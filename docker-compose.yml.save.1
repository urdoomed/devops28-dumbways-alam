version: '4'

services:
  database:
    image: mysql:8.0
    container_name: wayshub-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: ${hardiansyah}
      MYSQL_DATABASE: ${wayshubnew}
      MYSQL_USER: ${alamsyah}
      MYSQL_PASSWORD: ${Hardiansyah1!}
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - wayshub-network

  backend:
    build:
      context: ./wayshub-backend
    container_name: wayshub-backend
    restart: always
    depends_on:
      - database
    environment:
      - NODE_ENV=production
      - PORT=5000
    ports:
      - "5000:5000"
    networks:
      - wayshub-network

  frontend:
    build:
      context: ./wayshub-frontend
    container_name: wayshub-frontend
    restart: always
    depends_on:
      - backend
    ports:
      - "3000:80"
    networks:
      - wayshub-network

# Jaringan v
networks:
  wayshub-network:
    driver: bridge

# Volume agar data database tidak hilang saat container di-restart
volumes:
  db_data:
